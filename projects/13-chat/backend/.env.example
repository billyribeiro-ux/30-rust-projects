# Copy to .env. Never commit .env.
#
# Postgres + MailHog come up via `docker compose up -d` in the project root.
DATABASE_URL=postgres://chat:chat_dev_password@localhost:5432/chat

SMTP_URL=smtp://localhost:1025
SMTP_FROM=noreply@chat.local

FRONTEND_ORIGIN=http://localhost:5185
PORT=3012

# 32+ bytes in prod: `openssl rand -base64 32`
COOKIE_SECRET=dev_secret_change_me_in_prod_minimum_32_bytes_xxxxxx

# Used in email links (verify, reset)
PUBLIC_URL=http://localhost:5185

RUST_LOG=chat_backend=debug,tower_http=info,sqlx=warn
