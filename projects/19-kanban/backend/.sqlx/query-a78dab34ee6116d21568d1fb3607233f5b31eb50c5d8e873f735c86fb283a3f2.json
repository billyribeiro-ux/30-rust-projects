  "query": "\n        SELECT c.id AS \"id!\", c.card_id AS \"card_id!\", c.author_id AS \"author_id!\",\n               u.email AS \"author_email!\", u.name AS \"author_name!\",\n               c.body AS \"body!\", c.created_at AS \"created_at!\"\n        FROM comments c\n        JOIN users u ON u.id = c.author_id\n        WHERE c.id = $1\n        ",
