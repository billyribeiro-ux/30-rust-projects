{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT r.id AS \"id!: Uuid\",\n               r.user_id AS \"user_id!: Uuid\",\n               u.name    AS \"user_name!\",\n               r.rating  AS \"rating!: i16\",\n               r.body    AS \"body!\",\n               r.created_at AS \"created_at!: DateTime<Utc>\"\n        FROM reviews r\n        JOIN users u ON u.id = r.user_id\n        WHERE r.place_id = $1\n        ORDER BY r.created_at DESC\n        LIMIT 50\n        ",
