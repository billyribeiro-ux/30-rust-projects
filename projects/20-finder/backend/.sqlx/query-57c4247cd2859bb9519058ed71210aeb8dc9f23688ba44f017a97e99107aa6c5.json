  "db_name": "PostgreSQL",
  "query": "\n        SELECT fr.friend_id, u.email AS friend_email,\n               fr.place_id, p.name AS place_name, fr.created_at\n        FROM friend_recs fr\n        JOIN users  u ON u.id = fr.friend_id\n        JOIN places p ON p.id = fr.place_id\n        WHERE fr.user_id = $1\n        ORDER BY fr.created_at DESC\n        LIMIT 200\n        ",
