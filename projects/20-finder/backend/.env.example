DATABASE_URL=postgres://finder:finder_dev_password@localhost:5441/finder
FRONTEND_ORIGIN=http://localhost:5192
PORT=3019
PUBLIC_URL=http://localhost:5192
RUST_LOG=finder_backend=debug,tower_http=info,sqlx=warn
SECURE_COOKIES=false

# OAuth — issue your own at the provider consoles.
# Callback URLs (register both at the provider):
#   http://localhost:3019/api/auth/oauth/google/callback
#   http://localhost:3019/api/auth/oauth/github/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:3019

# Where the browser lands after a successful OAuth callback. Must be
# absolute so we can 303 redirect cross-origin from the backend back
# to SvelteKit dev/preview.
OAUTH_SUCCESS_REDIRECT=http://localhost:5192/
OAUTH_FAILURE_REDIRECT=http://localhost:5192/login?error=oauth
