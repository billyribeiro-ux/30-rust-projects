DATABASE_URL=postgres://jobs:jobs_dev_password@localhost:5443/jobs
FRONTEND_ORIGIN=http://localhost:5194
PORT=3021
RUST_LOG=jobs_backend=debug,tower_http=info,sqlx=warn
SECURE_COOKIES=false

# Worker mode toggle — set to 1 if this process should also poll the queue.
RUN_WORKERS=1
WORKER_CONCURRENCY=4
WORKER_LEASE_SECS=60

# Optional OTLP endpoint for tracing export (Tempo/Jaeger).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
