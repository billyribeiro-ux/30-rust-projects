{
  "db_name": "PostgreSQL",
  "query": "\n        WITH claimed AS (\n            SELECT id\n            FROM jobs\n            WHERE queue = $1\n              AND status = 'pending'\n              AND run_at <= now()\n            ORDER BY run_at\n            LIMIT $2\n            FOR UPDATE SKIP LOCKED\n        )\n        UPDATE jobs\n        SET status = 'running',\n            locked_until = $3,\n            locked_by = $4,\n            attempts = attempts + 1,\n            updated_at = now()\n        FROM claimed\n        WHERE jobs.id = claimed.id\n        RETURNING\n            jobs.id,\n            jobs.queue,\n            jobs.kind,\n            jobs.payload,\n            jobs.attempts,\n            jobs.max_attempts,\n            jobs.run_at,\n            jobs.locked_until,\n            jobs.locked_by,\n            jobs.status,\n            jobs.last_error,\n            jobs.created_at,\n            jobs.updated_at\n        ",
