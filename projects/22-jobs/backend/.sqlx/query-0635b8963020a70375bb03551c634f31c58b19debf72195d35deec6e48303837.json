  "query": "\n        SELECT id, queue, kind, attempts, max_attempts, status, run_at, last_error,\n               created_at, updated_at\n        FROM jobs\n        WHERE queue = $1 AND status = $2\n        ORDER BY created_at DESC\n        LIMIT $3\n        ",
