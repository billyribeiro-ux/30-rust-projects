{
  "name": "jobs-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 5194",
    "build": "vite build",
    "preview": "vite preview --port 4194",
    "prepare": "svelte-kit sync || echo ''",
