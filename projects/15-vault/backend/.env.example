DATABASE_URL=postgres://vault:vault_dev_password@localhost:5436/vault
FRONTEND_ORIGIN=http://localhost:5187
PORT=3014
PUBLIC_URL=http://localhost:5187
RUST_LOG=vault_backend=debug,tower_http=info,sqlx=warn

# Storage backend: either "local" (default) or "s3" (MinIO compatible).
# When VAULT_STORAGE=local, blobs go under VAULT_LOCAL_ROOT.
# When VAULT_STORAGE=s3 we connect to S3/MinIO with the AWS_ env vars below.
VAULT_STORAGE=local
VAULT_LOCAL_ROOT=./data/blobs
VAULT_UPLOAD_TMP=./data/uploads

# S3 / MinIO settings (only used when VAULT_STORAGE=s3)
AWS_ENDPOINT=http://localhost:9011
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_BUCKET=vault
