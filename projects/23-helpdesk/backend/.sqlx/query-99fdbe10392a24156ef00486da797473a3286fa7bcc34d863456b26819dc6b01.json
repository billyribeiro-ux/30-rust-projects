  "query": "\n        SELECT t.id, t.slug, t.name, m.role, t.sla_first_response_minutes,\n               t.sla_resolve_minutes, t.created_at\n        FROM memberships m JOIN tenants t ON t.id = m.tenant_id\n        WHERE m.user_id = $1\n        ORDER BY t.created_at DESC\n        ",
