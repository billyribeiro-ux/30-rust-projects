# Copy to .env. Never commit .env.
#
# Postgres + MailHog come up via `docker compose up -d` in the project root.
DATABASE_URL=postgres://applications:applications_dev_password@localhost:5432/applications

# SMTP: MailHog catches everything at :1025 and shows it at http://localhost:8025
SMTP_URL=smtp://localhost:1025
SMTP_FROM=noreply@applications.local

FRONTEND_ORIGIN=http://localhost:5184
PORT=3011

# Generate a fresh 32-byte secret in prod: `openssl rand -base64 32`
# This signs the session cookie's MAC for tamper-detection.
COOKIE_SECRET=dev_secret_change_me_in_prod_minimum_32_bytes_xxxxxx

# Public URL used in email links (verify, reset)
PUBLIC_URL=http://localhost:5184

RUST_LOG=applications_backend=debug,tower_http=info,sqlx=warn
