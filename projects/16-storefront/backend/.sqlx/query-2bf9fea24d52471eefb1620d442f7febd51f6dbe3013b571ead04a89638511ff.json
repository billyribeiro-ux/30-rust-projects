  "db_name": "PostgreSQL",
  "query": "\n        SELECT dl.id, dl.expires_at, dl.used_at, dl.revoked_at,\n               p.file_path, p.file_name, p.name AS product_name\n        FROM download_links dl\n        JOIN products p ON p.id = dl.product_id\n        WHERE dl.token_hash = $1\n        ",
