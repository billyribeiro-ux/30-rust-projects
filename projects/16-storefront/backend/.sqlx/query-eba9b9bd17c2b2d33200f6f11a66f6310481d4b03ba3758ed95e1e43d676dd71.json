{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT s.id AS session_id, s.user_id, s.expires_at,\n               u.email, u.name, u.email_verified_at\n        FROM sessions s\n        JOIN users u ON u.id = s.user_id\n        WHERE s.token_hash = $1\n          AND s.expires_at > now()\n        ",
