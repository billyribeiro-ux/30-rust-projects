DATABASE_URL=postgres://aiapi:aiapi_dev_password@localhost:5449/aiapi
FRONTEND_ORIGIN=http://localhost:5200
PORT=3027
PUBLIC_URL=http://localhost:5200
RUST_LOG=ai_api_backend=debug,tower_http=info,sqlx=warn
SECURE_COOKIES=false

# WebAuthn relying-party id (must equal the public host).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=AI Inference API
WEBAUTHN_ORIGIN=http://localhost:5200

# Free tier: first N requests/month free, then $0.001/call.
FREE_TIER_CALLS=10000
PER_CALL_CENTS=0.1

# Mock LLM endpoint. Production: any OpenAI-compatible endpoint.
LLM_ENDPOINT=
