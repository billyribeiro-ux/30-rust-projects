{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, slug, title, summary,\n               similarity(title, $1)::float8 AS \"sim_score!: f64\"\n        FROM articles\n        WHERE published_at IS NOT NULL\n          AND similarity(title, $1) > 0.2\n        ORDER BY similarity(title, $1) DESC\n        LIMIT 20\n        ",
